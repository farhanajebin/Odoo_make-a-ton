# ==============================================================================
# LOOPNEX Platform — Environment Configuration
# Intelligent Subscription Management & Revenue Operations Platform
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loopnex_dev?schema=public

# Frontend Application
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=LOOPNEX
VITE_ENABLE_DEMO_MODE=true

# Security & Identity Engine (Commit 02)
JWT_ACCESS_SECRET=loopnex-access-secret-token-key-2026-production-ready
JWT_REFRESH_SECRET=loopnex-refresh-secret-token-key-2026-production-ready
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
RESET_TOKEN_EXPIRES_MINUTES=30
COOKIE_SECURE=false
EMAIL_FROM="LOOPNEX Security <security@loopnex.io>"
