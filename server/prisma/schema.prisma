// ==============================================================================
// LOOPNEX — Prisma Schema Definition
// Foundation Core | Commit 01
// Intelligent Subscription Management & Revenue Operations Platform
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum StaffDepartment {
  EXECUTIVE
  FINANCE
  SALES
  CUSTOMER_SUCCESS
  OPERATIONS
  ENGINEERING
}

enum CustomerStatus {
  LEAD
  ACTIVE
  DELINQUENT
  CHURNED
  ARCHIVED
}

enum ProductType {
  RECURRING_SUBSCRIPTION
  ONE_TIME_CHARGE
  USAGE_METERED
  ADDON
}

enum BillingCadence {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  CUSTOM
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

enum PaymentMethodType {
  CREDIT_CARD
  ACH_DIRECT_DEBIT
  SEPA
  BANK_TRANSFER
  MANUAL
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
  STATUS_CHANGE
}

// ------------------------------------------------------------------------------
// Foundational Security & Identity Models (Commit 01 Core)
// ------------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("[]") // Array of granular permission strings
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  staffProfile  Staff?
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([email])
  @@index([roleId])
  @@map("users")
}

model Staff {
  id         String          @id @default(cuid())
  userId     String          @unique
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  department StaffDepartment @default(OPERATIONS)
  phone      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  assignedCustomers Customer[]
  managedQuotations Quotation[]

  @@map("staff")
}

// ------------------------------------------------------------------------------
// Future Domain Models (Prepared Architecture — Planned Entities)
// Note: All monetary amounts use Prisma Decimal (@db.Decimal) to prevent floating-point errors.
// ------------------------------------------------------------------------------

model Customer {
  id           String         @id @default(cuid())
  legalName    String
  tradingName  String?
  email        String         @unique
  phone        String?
  taxId        String?
  currency     String         @default("USD")
  status       CustomerStatus @default(ACTIVE)
  assignedToId String?
  assignedTo   Staff?         @relation(fields: [assignedToId], references: [id])
  billingAddress Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  subscriptions Subscription[]
  quotations    Quotation[]
  invoices      Invoice[]
  payments      Payment[]
  discountUsages DiscountUsage[]

  @@index([email])
  @@index([status])
  @@map("customers")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  description String?
  type        ProductType @default(RECURRING_SUBSCRIPTION)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  variants ProductVariant[]
  plans    SubscriptionPlan[]

  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  name      String
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_variants")
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  code          String         @unique
  name          String
  description   String?
  cadence       BillingCadence @default(MONTHLY)
  price         Decimal        @db.Decimal(12, 2)
  currency      String         @default("USD")
  trialDays     Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model QuotationTemplate {
  id          String   @id @default(cuid())
  name        String
  contentJson Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotations Quotation[]

  @@map("quotation_templates")
}

model Quotation {
  id           String          @id @default(cuid())
  quoteNumber  String          @unique
  customerId   String
  customer     Customer        @relation(fields: [customerId], references: [id])
  templateId   String?
  template     QuotationTemplate? @relation(fields: [templateId], references: [id])
  staffId      String?
  staff        Staff?          @relation(fields: [staffId], references: [id])
  status       QuotationStatus @default(DRAFT)
  subtotal     Decimal         @db.Decimal(12, 2)
  discountTotal Decimal        @default(0.00) @db.Decimal(12, 2)
  taxTotal     Decimal         @default(0.00) @db.Decimal(12, 2)
  total        Decimal         @db.Decimal(12, 2)
  validUntil   DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  lines QuotationLine[]

  @@map("quotations")
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("quotation_lines")
}

model Subscription {
  id          String             @id @default(cuid())
  subNumber   String             @unique
  customerId  String
  customer    Customer           @relation(fields: [customerId], references: [id])
  planId      String
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id])
  status      SubscriptionStatus @default(ACTIVE)
  startedAt   DateTime
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  lines          SubscriptionLine[]
  invoices       Invoice[]
  billingPeriods BillingPeriod[]

  @@index([customerId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int          @default(1)
  unitPrice      Decimal      @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("subscription_lines")
}

model Tax {
  id          String   @id @default(cuid())
  name        String
  rate        Decimal  @db.Decimal(6, 4) // e.g., 0.0825 for 8.25%
  country     String
  state       String?
  isCompound  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("taxes")
}

model Discount {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType @default(PERCENTAGE)
  value       Decimal      @db.Decimal(12, 2)
  maxRedemptions Int?
  currentRedemptions Int   @default(0)
  validFrom   DateTime
  validTo     DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  usages DiscountUsage[]

  @@map("discounts")
}

model DiscountUsage {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  usedAt     DateTime @default(now())

  @@map("discount_usages")
}

model BillingPeriod {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  startDate      DateTime
  endDate        DateTime
  isBilled       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("billing_periods")
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNumber String      @unique
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  status      InvoiceStatus @default(ISSUED)
  dueDate     DateTime
  subtotal    Decimal       @db.Decimal(12, 2)
  taxTotal    Decimal       @default(0.00) @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0.00) @db.Decimal(12, 2)
  balanceDue  Decimal       @db.Decimal(12, 2)
  issuedAt    DateTime      @default(now())
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("invoice_lines")
}

model Payment {
  id          String            @id @default(cuid())
  reference   String            @unique
  invoiceId   String
  invoice     Invoice           @relation(fields: [invoiceId], references: [id])
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  method      PaymentMethodType @default(CREDIT_CARD)
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("USD")
  status      PaymentStatus     @default(SUCCEEDED)
  processedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("payments")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime    @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}
